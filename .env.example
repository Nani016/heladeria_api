# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo .env real a un repositorio.

# OBLIGATORIA. Mínimo 32 caracteres. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Minutos que dura el token de acceso
JWT_EXPIRA_MINUTOS=30

# Por defecto usa SQLite local. Para otra base de datos:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/heladeria

# Orígenes permitidos para CORS (separados por coma). Vacío = ninguno.
# CORS_ORIGINS=http://localhost:3000

# Límite de intentos de login por IP
LOGIN_RATE_LIMIT=5 per minute
